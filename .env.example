# owleye configuration. Copy to .env and edit — .env is never committed.
# Every value here can also be passed as a normal environment variable.

# --- server ---
OWLEYE_PORT=8443
OWLEYE_HOST=0.0.0.0

# Serve over HTTPS with a self-signed certificate (generated on first run).
# Required for phones: browsers block the camera on a plain-HTTP LAN address.
# Leave at 0 when a reverse proxy terminates TLS (see DEPLOY.md).
OWLEYE_HTTPS=0

# Use a real certificate instead of the generated self-signed one. Set both or
# neither. With these, browsers show no warning.
OWLEYE_TLS_KEY=
OWLEYE_TLS_CERT=

# Where the self-signed pair is generated and cached.
OWLEYE_CERT_DIR=./certs

# Shared secret. When set, every request needs it (?t=..., x-owleye-token
# header, or the cookie the server hands out). Leave empty for local-only use.
OWLEYE_TOKEN=

# Where clips and metadata are written.
OWLEYE_DATA_DIR=./data

# Alert when a camera stops sending heartbeats, in seconds. 0 disables.
OWLEYE_OFFLINE_AFTER=120

# Reject a single upload larger than this (bytes). Default 1 MiB.
OWLEYE_MAX_UPLOAD=1048576

# Per-session limits, enforced for the main session and every self-signup one.
# Total on-disk budget per session (bytes, default 10 MiB): when full, the
# oldest events are deleted first; an event that still cannot fit is refused.
OWLEYE_SESSION_MAX_BYTES=10485760
# Delete an event this many seconds after it is stored (default 24h).
OWLEYE_RETENTION_SECONDS=86400
# Cap on POST /api/event per session, per minute (429 over the limit).
OWLEYE_EVENT_RATE_PER_MINUTE=30

# How many reverse proxies sit in front of owleye. 0 = exposed directly. Set to
# 1 behind a single Caddy/nginx so the real client IP is read from
# X-Forwarded-For (needed for the signup rate limit to work per client).
OWLEYE_TRUSTED_PROXIES=0

# Allow non-HTTPS / loopback outbound targets (ntfy, Web Push). Leave 0 in
# production; only for a local dev server talking to a mock on localhost.
OWLEYE_DEV_ALLOW_INSECURE_OUTBOUND=0

# Do not hold macOS awake with caffeinate.
OWLEYE_NO_CAFFEINATE=0

# --- adapters ---
# Comma-separated, in delivery order: file, ntfy, webpush, telegram, webhook, console.
OWLEYE_ADAPTERS=file,console

# --- ntfy (phone app, free) ---
# Pick a long random topic — on ntfy.sh it is the only secret. Subscribe to the
# same topic in the ntfy app (Android / iOS) or at https://ntfy.sh/<topic>.
# NTFY_URL points at a self-hosted server; NTFY_TOKEN is for reserved topics.
# Self-signup: anyone on the gate page can create an isolated session (own feed,
# clips, ntfy). Off by default; meant for trials. OWLEYE_MAX_SESSIONS caps the total.
OWLEYE_OPEN_SIGNUP=0
OWLEYE_MAX_SESSIONS=500
# Cross-IP cap on new sessions per minute, to blunt a distributed flood.
OWLEYE_SIGNUP_GLOBAL_PER_MINUTE=20

NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=
# Origins a public (self-signup) session may post ntfy to. https://ntfy.sh and
# your own NTFY_URL are always allowed; add more here, comma-separated.
OWLEYE_NTFY_ALLOWED_ORIGINS=
# Priority for motion and offline alerts: min, low, default, high, urgent.
NTFY_PRIORITY=high

# --- web push (browser notifications, no third party) ---
# Nothing to configure: add "webpush" to OWLEYE_ADAPTERS, then press
# "Включить" under "Уведомления на это устройство" in the UI. The VAPID pair is
# generated on first run into <OWLEYE_DATA_DIR>/webpush/. Set the subject to
# your own address — push services may contact it about abuse.
WEBPUSH_SUBJECT=mailto:you@example.com
# Supply both to reuse a pair across servers (base64url, as in vapid.json).
WEBPUSH_VAPID_PUBLIC=
WEBPUSH_VAPID_PRIVATE=
# Seconds a push may wait at the push service for an offline phone.
WEBPUSH_TTL=3600
# Cap on push subscriptions one session may register.
WEBPUSH_MAX_SUBS_PER_SESSION=20

# --- telegram ---
# Note: api.telegram.org is unreachable from some networks (Russian cloud
# providers among them) — prefer ntfy or webpush there.
# Create a bot with @BotFather, then message it once and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SILENT=0

# --- webhook ---
# Receives POST with the raw media and an x-owleye-event base64 JSON header.
OWLEYE_WEBHOOK_URL=
OWLEYE_WEBHOOK_SECRET=
